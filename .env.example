# Kopieer dit bestand naar .env.local en vul de waarden in.
#
# Zero-Touch EU-architectuur: de browser praat rechtstreeks met Supabase (regio Frankfurt).
# Op de hosting (Netlify / Cloudflare Pages) staan ENKEL deze twee publieke sleutels.
# Nooit de service-role key en nooit RESEND_API_KEY in deze applicatie of op de hosting:
# e-mailsleutels horen bij Supabase > Edge Functions > Secrets.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
