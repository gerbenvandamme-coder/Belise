# Kopieer dit bestand naar .env.local en vul de waarden in.

# API-sleutel uit het Resend-dashboard.
RESEND_API_KEY=

# Afzender. Het domein moet in Resend geverifieerd zijn, bijvoorbeeld: Belise <afspraken@jouwdomein.be>
EMAIL_FROM=

# E-mailadres van de eigenares, voor de notificatie bij een bevestigde afspraak.
OWNER_EMAIL=

# Publieke basis-URL van de site. Verplicht in productie, bijvoorbeeld: https://belise.be
SITE_URL=http://localhost:3000